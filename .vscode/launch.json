{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python:Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",

      "args": ["run", "${file}"]
    },
    {
      "name": "Python:Streamlit with Args",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",

      "args": ["run", "${file}", "--", "--data_dir", "data"]
    }
  ]
}
