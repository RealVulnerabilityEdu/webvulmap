{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ka.schema.v2.json",
  "title": "CS2023 Knowledge Area Schema v2",
  "type": "object",
  "required": ["schema", "knowledge_area", "description", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "$id": { "type": "string", "format": "uri" },

    "schema": {
      "type": "object",
      "required": ["name", "version", "generated_at", "source"],
      "properties": {
        "name": { "const": "ka.schema.v2" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "source": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "edition": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },

    "knowledge_area": {
      "type": "object",
      "required": ["name", "code"],
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string", "pattern": "^[A-Z]{2,5}$" }
      },
      "additionalProperties": false
    },

    "description": { "type": "string" },

    "section_order": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },

    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "additionalProperties": false,

  "$defs": {
    "topic": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "weight": { "type": "number" },
        "aka": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "learning_outcome": {
      "type": "object",
      "required": ["id", "text", "cognitive_level"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "cognitive_level": {
          "type": "string",
          "enum": [
            "Remember",
            "Understand",
            "Apply",
            "Analyze",
            "Evaluate",
            "Create"
          ]
        }
      },
      "additionalProperties": false
    },

    "bullet": {
      "type": "object",
      "required": ["id", "text", "subbullets"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "subbullets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bullet" }
        }
      },
      "additionalProperties": false
    },

    "crossref": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string", "enum": ["CWE", "CVE", "KA", "EXT"] },
        "target": { "type": "string" },
        "rel": { "type": "string", "enum": ["related", "prereq", "overlaps"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "source_loc": {
      "type": "object",
      "required": ["pages", "anchors"],
      "properties": {
        "pages": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 1 },
            "end": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "label": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "qa_flags": {
      "type": "object",
      "required": ["needs_review", "reasons", "notes"],
      "properties": {
        "needs_review": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "order",
        "summary",
        "topics",
        "learning_outcomes",
        "bullets",
        "crossrefs",
        "qa_flags",
        "source_loc",
        "subsections"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "ka_code": { "type": "string", "pattern": "^[A-Z]{2,5}$" },
        "title": { "type": "string" },
        "order": { "type": "number" },
        "summary": { "type": "string" },

        "content_as_text": { "type": "string" },
        "content_as_md": { "type": "string" },

        "topics": {
          "type": "array",
          "items": { "$ref": "#/$defs/topic" }
        },

        "learning_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/learning_outcome" }
        },

        "bullets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bullet" }
        },

        "crossrefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/crossref" }
        },

        "qa_flags": { "$ref": "#/$defs/qa_flags" },

        "source_loc": { "$ref": "#/$defs/source_loc" },

        "subsections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      },
      "additionalProperties": false
    }
  }
}
